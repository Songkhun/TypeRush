<mxfile host="drawio" version="26.0.0">
  <diagram id="typerush-flow" name="TypeRush guide">
    <mxGraphModel dx="1700" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1260" background="#0b0f1a" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="TypeRush: how to run it, use it and set it up" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=28;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Follow the arrows. Purple = getting started, cyan = typing practice, amber = arcade, pink = results. Dashed boxes are tips." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#8691b3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1300" height="26" as="geometry"/></mxCell>
<mxCell id="run" value="1 · RUN  (start the app)" style="swimlane;startSize=36;html=1;rounded=1;arcSize=2;fillColor=#2a2160;swimlaneFillColor=#121829;strokeColor=#a78bfa;fontColor=#ffffff;fontStyle=1;fontSize=17;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1620" height="260" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;b&gt;Install once&lt;/b&gt;&lt;br&gt;npm install" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1b1840;strokeColor=#a78bfa;fontColor=#ede9fe;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="run"><mxGeometry x="30" y="60" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;Build the Mac app&lt;/b&gt;&lt;br&gt;npm run mac-app" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1b1840;strokeColor=#a78bfa;fontColor=#ede9fe;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="run"><mxGeometry x="290" y="60" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;Drag TypeRush.app&lt;/b&gt;&lt;br&gt;from ~/Applications to the Dock" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1b1840;strokeColor=#a78bfa;fontColor=#ede9fe;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="run"><mxGeometry x="550" y="60" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="r4" value="&lt;b&gt;Click the TypeRush icon&lt;/b&gt;&lt;br&gt;Dock, Finder or Spotlight" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1b1840;strokeColor=#a78bfa;fontColor=#ede9fe;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="run"><mxGeometry x="810" y="60" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="r5" value="&lt;b&gt;Opens in its own window&lt;/b&gt;&lt;br&gt;local server 127.0.0.1:4747" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1b1840;strokeColor=#a78bfa;fontColor=#ede9fe;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="run"><mxGeometry x="1070" y="60" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="r6" value="&lt;b&gt;Quit with ⌘Q&lt;/b&gt;&lt;br&gt;the server stops by itself" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1b1840;strokeColor=#a78bfa;fontColor=#ede9fe;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="run"><mxGeometry x="1350" y="60" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="n_dev" value="&lt;b&gt;Developer mode:&lt;/b&gt; npm run dev, then open http://localhost:5173 (separate progress)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#182038;strokeColor=#6b7799;fontColor=#c9d1e0;dashed=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="run"><mxGeometry x="30" y="170" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="n_rebuild" value="&lt;b&gt;Changed the code?&lt;/b&gt; Run npm run mac-app again to rebuild the app" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#182038;strokeColor=#6b7799;fontColor=#c9d1e0;dashed=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="run"><mxGeometry x="450" y="170" width="460" height="60" as="geometry"/></mxCell>
