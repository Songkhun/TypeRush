<mxCell id="o_sound" value="&lt;b&gt;Sound&lt;/b&gt;&lt;br&gt;• On / Off&lt;br&gt;• Key sound: Mechanical, Typewriter, Soft pop, Retro arcade (click one to hear it)&lt;br&gt;• Volume 0–100%" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#182038;strokeColor=#fbbf24;fontColor=#c9d1e0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="opt"><mxGeometry x="20" y="56" width="300" height="194" as="geometry"/></mxCell>
<mxCell id="o_look" value="&lt;b&gt;Look&lt;/b&gt;&lt;br&gt;• Color theme: Neon, Matrix, Sunset, Ocean, Mono&lt;br&gt;• Font: JetBrains Mono, Fira Code, Roboto Mono, Sarabun, Kanit (all show Thai)&lt;br&gt;• Text size slider with live preview" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#182038;strokeColor=#fbbf24;fontColor=#c9d1e0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="opt"><mxGeometry x="340" y="56" width="300" height="194" as="geometry"/></mxCell>
<mxCell id="o_practice" value="&lt;b&gt;Practice&lt;/b&gt;&lt;br&gt;• Effects: off / subtle / full&lt;br&gt;• Daily goal: 1–120 minutes (meet it to grow your 🔥 streak)&lt;br&gt;• On-screen keyboard: shown / hidden&lt;br&gt;• Reset progress (keeps settings)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#182038;strokeColor=#fbbf24;fontColor=#c9d1e0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="opt"><mxGeometry x="660" y="56" width="300" height="194" as="geometry"/></mxCell>
<mxCell id="o_modes" value="&lt;b&gt;In each mode&lt;/b&gt;&lt;br&gt;• Language: EN / TH&lt;br&gt;• Test length: 15s, 30s, 60s or 10, 25, 50 words&lt;br&gt;• Drill picks your weak keys automatically&lt;br&gt;• Arcade: 3 lives, ×4 max multiplier, boss every 5th wave" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#182038;strokeColor=#fbbf24;fontColor=#c9d1e0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="opt"><mxGeometry x="980" y="56" width="300" height="194" as="geometry"/></mxCell>
<mxCell id="o_keys" value="&lt;b&gt;Keys&lt;/b&gt;&lt;br&gt;• Tab: restart&lt;br&gt;• Backspace: fix a mistake&lt;br&gt;• Space: next word&lt;br&gt;• Enter: next run / play again&lt;br&gt;• Esc: drop arcade target&lt;br&gt;• ⌃Space: EN ↔ TH keyboard&lt;br&gt;• ⌘Q: quit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#182038;strokeColor=#fbbf24;fontColor=#c9d1e0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="opt"><mxGeometry x="1300" y="56" width="300" height="194" as="geometry"/></mxCell>
<mxCell id="e_settings" value="open Settings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#8691b3;strokeWidth=2;fontColor=#e7ecf7;fontSize=12;labelBackgroundColor=#0b0f1a;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_home" target="opt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
