<mxCell id="use" value="2 · USE  (practice every day)" style="swimlane;startSize=36;html=1;rounded=1;arcSize=2;fillColor=#0f3a48;swimlaneFillColor=#121829;strokeColor=#22d3ee;fontColor=#ffffff;fontStyle=1;fontSize=17;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1620" height="430" as="geometry"/></mxCell>
<mxCell id="u_home" value="&lt;b&gt;Home&lt;/b&gt;&lt;br&gt;daily goal ring&lt;br&gt;recent runs" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1b1840;strokeColor=#a78bfa;fontColor=#ede9fe;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="use"><mxGeometry x="20" y="170" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="u_lang" value="&lt;b&gt;Pick language&lt;/b&gt;&lt;br&gt;EN / TH in the top bar" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1b1840;strokeColor=#a78bfa;fontColor=#ede9fe;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="use"><mxGeometry x="250" y="170" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="u_mode" value="Choose a mode" style="rhombus;whiteSpace=wrap;html=1;fillColor=#1b1840;strokeColor=#a78bfa;fontColor=#ede9fe;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="use"><mxGeometry x="480" y="150" width="160" height="110" as="geometry"/></mxCell>
<mxCell id="u_test" value="&lt;b&gt;Test&lt;/b&gt;&lt;br&gt;15s · 30s · 60s&lt;br&gt;or 10 · 25 · 50 words" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#0f2a35;strokeColor=#22d3ee;fontColor=#e0fbff;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="use"><mxGeometry x="700" y="40" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="u_drill" value="&lt;b&gt;Drill&lt;/b&gt;&lt;br&gt;words built from your&lt;br&gt;5 weakest keys" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#0f2a35;strokeColor=#22d3ee;fontColor=#e0fbff;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="use"><mxGeometry x="700" y="170" width="200" height="70" as="geometry"/></mxCell>
